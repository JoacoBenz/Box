# PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-32-chars-minimum"

# Super admin (solo usado por prisma/seed.ts la primera vez, sobre una DB vacía)
# Si no los seteas, el seed genera una password random de 24 chars y la imprime
# en stderr una única vez. Conservalos en un password manager.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_INITIAL_PASSWORD=""

# OAuth (optional – SSO login)
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""
AUTH_MICROSOFT_CLIENT_ID=""
AUTH_MICROSOFT_CLIENT_SECRET=""
AUTH_MICROSOFT_TENANT_ID="common"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email (Gmail SMTP)
GMAIL_USER="tu-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Box <tu-email@gmail.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Pago (opcional — billing; activa cuando las 3 primeras estén seteadas)
# MP_ACCESS_TOKEN: de Dashboard → Your integrations → Credenciales (test o prod).
# MP_WEBHOOK_SECRET: de Dashboard → Webhooks, secreta de firma (x-signature).
# MP_PLAN_ID: ID del Preapproval Plan (legacy — ya no es obligatorio porque
#   el checkout usa auto_recurring directo, pero queda referenciado).
# MP_TEST_BUYER_EMAIL: SOLO en sandbox. Email del buyer test user. MP exige
#   match test/real entre payer y collector — sin esto, sandbox rechaza con
#   "Both payer and collector must be real or test users". En PRODUCCIÓN dejar
#   VACÍO: no pasamos payer_email a MP, así el dueño de la cuenta MP que paga
#   puede ser distinto del admin de la app (ej. director usa el sistema y CFO
#   con cuenta MP propia hace el pago).
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_PLAN_ID=""
MP_TEST_BUYER_EMAIL=""

# Sentry (optional – error tracking; activates only if DSN is set)
# Get free-tier credentials at https://sentry.io (5k errors/month free)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Mission Control (optional — centralized monitoring dashboard).
# Register this app in the dashboard (its /api/health URL), copy the API key it
# shows once, and set both below. With them set, lib/logger.ts ships warn/error
# to Mission Control's /api/ingest (Sentry still works independently).
MISSION_CONTROL_URL=""
MISSION_CONTROL_API_KEY=""
# Release tag attached to reports for deploy correlation. Optional — falls back
# to a git SHA env var, then the package version.
APP_RELEASE=""
